// gh-skills — PR lifecycle flow
// Render:  ./assets/build-diagram.sh   (dot + animated-SVG injection)
// Source of truth: this file. The SVG in assets/ is generated from it.
digraph PR_FLOW {
  rankdir=LR;
  splines=polyline;
  bgcolor="#ffffff";
  pad="0.4";
  nodesep="0.30";
  ranksep="0.55";

  node [shape=box, style="rounded,filled", fontname="Helvetica,Arial,sans-serif",
        fontsize=10, fontcolor="#1f2328", color="#4f46e5", fillcolor="#eef2ff",
        margin="0.13,0.07", height=0.32];
  edge [color="#4f46e5", fontname="Helvetica,Arial,sans-serif", fontsize=8,
        fontcolor="#57606a", arrowsize=0.65];

  // ---------------- spine: main -> ... -> done ----------------
  main   [label="main", shape=circle, fixedsize=true, width=0.8, height=0.8,
          fillcolor="#d1fae5", color="#059669", fontcolor="#065f46", penwidth=2];
  sync   [label="git fetch origin\nresolve default branch"];
  plan   [class="pulse", label="pr-manager\nplan + prioritize\n(20+ PRs)", shape=box3d,
          fillcolor="#f5f3ff", color="#7c3aed"];
  fanout [class="pulse", label="dispatch one\nsubagent per PR", shape=parallelogram,
          fillcolor="#f5f3ff", color="#7c3aed"];
  issue  [label="no issue?\ncreate + link\n(DoD gate)", fillcolor="#fef3c7", color="#b45309"];

  // ---------------- parallel task tree ----------------
  subgraph cluster_tasks {
    label="parallel sub-sessions (one per task)";
    fontname="Helvetica,Arial,sans-serif"; fontsize=10; fontcolor="#57606a";
    color="#d0d7de"; style="rounded,dashed"; bgcolor="#fafbfc";

    a_wt   [label="pr-worktree\nfix-issue-432", fillcolor="#fff7ed", color="#c2410c"];
    a_impl [label="implement", fillcolor="#fff7ed", color="#c2410c"];
    a_test [label="run tests", fillcolor="#fff7ed", color="#c2410c"];
    a_pr   [label="PR #101\nissue linked", fillcolor="#ecfdf5", color="#059669"];

    b_wt   [label="pr-worktree\nfeature-issue-444", fillcolor="#fff7ed", color="#c2410c"];
    b_impl [label="implement", fillcolor="#fff7ed", color="#c2410c"];
    b_test [label="run tests", fillcolor="#fff7ed", color="#c2410c"];
    b_pr   [label="PR #102\nissue linked", fillcolor="#ecfdf5", color="#059669"];

    c_wt   [label="pr-worktree\nrefactor-issue-445", fillcolor="#fff7ed", color="#c2410c"];
    c_impl [label="implement", fillcolor="#fff7ed", color="#c2410c"];
    c_test [label="run tests", fillcolor="#fff7ed", color="#c2410c"];
    c_pr   [label="PR #103\nissue linked", fillcolor="#ecfdf5", color="#059669"];

    a_wt -> a_impl -> a_test -> a_pr;
    b_wt -> b_impl -> b_test -> b_pr;
    c_wt -> c_impl -> c_test -> c_pr;

    // align the three parallel chains inside the cluster
    { rank=same; a_wt; b_wt; c_wt; }
    { rank=same; a_impl; b_impl; c_impl; }
    { rank=same; a_test; b_test; c_test; }
    { rank=same; a_pr; b_pr; c_pr; }
  }

  // ---------------- shared PR loop (cycles) ----------------
  monitor [class="pulse", label="monitor every 3 min\npr-feedback-handler", shape=box3d,
           fillcolor="#eef2ff", color="#4338ca"];
  fetchc  [label="fetch reviews +\ninline comments"];
  ci      [class="pulse", label="CI checks", shape=diamond, fillcolor="#fef9c3",
           color="#a16207", width=1.0, height=0.8];
  decide  [class="pulse", label="approved?", shape=diamond, fillcolor="#fef9c3",
           color="#a16207", width=1.0, height=0.8];
  fix     [label="pr-feedback-handler\nfix or reply", fillcolor="#fee2e2", color="#dc2626"];
  commit  [label="commit\n(explicit paths only)"];
  push    [label="git push origin\n<branch>"];
  label_  [label="pr-labeler\nauto-label", fillcolor="#f3f4f6", color="#6b7280"];

  merge   [class="pulse", label="pr-merger\nverify + merge", shape=box3d,
           fillcolor="#ecfdf5", color="#059669"];
  cleanup [class="pulse", label="cleanup\nworktree + branch"];
  done    [class="pulse", label="Definition of Done\nissue linked AND merged",
           shape=octagon, fillcolor="#d1fae5", color="#059669", fontcolor="#065f46"];

  // ---------------- edges ----------------
  main -> sync -> plan -> fanout;
  fanout -> issue [style=dashed, color="#b45309"];
  issue -> fanout [style=dashed, color="#b45309", constraint=false, label="resume"];

  fanout -> a_wt [label="task A"];
  fanout -> b_wt [label="task B"];
  fanout -> c_wt [label="task C"];

  a_pr -> monitor;
  b_pr -> monitor;
  c_pr -> monitor;
  a_pr -> label_ [style=dashed, color="#6b7280"];
  label_ -> monitor [style=dashed, color="#6b7280"];

  monitor -> fetchc -> decide;
  monitor -> ci;
  ci -> fix [label="failing", color="#dc2626", fontcolor="#dc2626"];
  decide -> fix [label="changes requested", color="#dc2626", fontcolor="#dc2626"];
  fix -> commit -> push;
  push -> monitor [label="re-review", style=dashed, color="#dc2626", fontcolor="#dc2626"];

  decide -> merge [label="approved"];
  merge -> cleanup -> done;
  done -> main [label="next task", style=dashed, color="#059669", fontcolor="#059669",
               constraint=false];

  // ---------------- explicit ranks: the flow reads left -> right ----------------
  { rank=same; main; }
  { rank=same; sync; }
  { rank=same; plan; }
  { rank=same; fanout; issue; }
  { rank=same; label_; }
  { rank=same; monitor; }
  { rank=same; fetchc; ci; }
  { rank=same; decide; }
  { rank=same; merge; fix; }
  { rank=same; cleanup; commit; }
  { rank=same; done; push; }
}
