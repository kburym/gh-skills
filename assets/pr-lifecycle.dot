// gh-skills — the pull request lifecycle, from main to merged.
// Render:  ./assets/build-diagram.sh   (dot + animated-SVG injection)
// Source of truth: this file. The SVG in assets/ is generated from it.
digraph PR_LIFECYCLE {
  rankdir=TB;
  splines=polyline;
  bgcolor="transparent";
  pad="0.35";
  nodesep="0.32";
  ranksep="0.58";
  fontname="Helvetica,Arial,sans-serif";

  node [shape=box, style="rounded,filled", fontname="Helvetica,Arial,sans-serif",
        fontsize=13, fontcolor="#111827", color="#4F46E5", fillcolor="#EEF2FF",
        penwidth=1.6, margin="0.16,0.10"];
  edge [color="#9CA3AF", fontname="Helvetica,Arial,sans-serif", fontsize=10,
        fontcolor="#6B7280", arrowsize=0.7, penwidth=1.2];

  // ---------------- the starting point ----------------
  main [label=<<b>main</b>>, shape=circle, fixedsize=true, width=0.9, height=0.9,
        fillcolor="#D1FAE5", color="#10B981", fontcolor="#065F46", penwidth=2.2];
  sync [label=<<b>Sync with the base branch</b><br/><font point-size="10" color="#6B7280">never touch the main checkout</font>>,
        fillcolor="#F9FAFB", color="#9CA3AF"];
  plan [label=<<b>pr-manager</b><br/><font point-size="10" color="#6D28D9">plan and prioritise · ~1s</font>>,
        shape=box3d, fillcolor="#F5F3FF", color="#7C3AED"];
  fanout [label=<<b>One agent per task</b><br/><font point-size="10" color="#6D28D9">20+ lanes in parallel</font>>,
          shape=parallelogram, fillcolor="#F5F3FF", color="#7C3AED"];
  issue [label=<<b>No issue yet?</b><br/><font point-size="10" color="#92400E">create and link it</font>>,
         fillcolor="#FEF3C7", color="#EAB308"];

  // ---------------- parallel work ----------------
  subgraph cluster_tasks {
    label=<<b>Twenty lanes, twenty worktrees, zero collisions</b>>;
    fontname="Helvetica,Arial,sans-serif"; fontsize=12; fontcolor="#374151";
    color="#E5E7EB"; style="rounded,dashed"; penwidth=1.4; bgcolor="#FAFAFB";

    a_wt   [label=<<b>Isolate</b><br/><font point-size="10" color="#9A3412">pr-worktree</font>>, fillcolor="#FFF7ED", color="#F97316"];
    a_impl [label=<<b>Build</b><br/><font point-size="10" color="#9A3412">the agent</font>>, fillcolor="#FFF7ED", color="#F97316"];
    a_test [label=<<b>Test</b><br/><font point-size="10" color="#9A3412">repo suite</font>>, fillcolor="#FFF7ED", color="#F97316"];
    a_pr   [label=<<b>PR #101</b><br/><font point-size="10" color="#047857">issue linked</font>>, fillcolor="#ECFDF5", color="#10B981"];

    b_wt   [label=<<b>Isolate</b><br/><font point-size="10" color="#9A3412">pr-worktree</font>>, fillcolor="#FFF7ED", color="#F97316"];
    b_impl [label=<<b>Build</b><br/><font point-size="10" color="#9A3412">the agent</font>>, fillcolor="#FFF7ED", color="#F97316"];
    b_test [label=<<b>Test</b><br/><font point-size="10" color="#9A3412">repo suite</font>>, fillcolor="#FFF7ED", color="#F97316"];
    b_pr   [label=<<b>PR #102</b><br/><font point-size="10" color="#047857">issue linked</font>>, fillcolor="#ECFDF5", color="#10B981"];

    c_wt   [label=<<b>Isolate</b><br/><font point-size="10" color="#9A3412">pr-worktree</font>>, fillcolor="#FFF7ED", color="#F97316"];
    c_impl [label=<<b>Build</b><br/><font point-size="10" color="#9A3412">the agent</font>>, fillcolor="#FFF7ED", color="#F97316"];
    c_test [label=<<b>Test</b><br/><font point-size="10" color="#9A3412">repo suite</font>>, fillcolor="#FFF7ED", color="#F97316"];
    c_pr   [label=<<b>PR #103</b><br/><font point-size="10" color="#047857">issue linked</font>>, fillcolor="#ECFDF5", color="#10B981"];

    a_wt -> a_impl -> a_test -> a_pr;
    b_wt -> b_impl -> b_test -> b_pr;
    c_wt -> c_impl -> c_test -> c_pr;

    { rank=same; a_wt; b_wt; c_wt; }
    { rank=same; a_impl; b_impl; c_impl; }
    { rank=same; a_test; b_test; c_test; }
    { rank=same; a_pr; b_pr; c_pr; }
  }

  // ---------------- the loop ----------------
  monitor [class="pulse", label=<<b>Watch it</b><br/><font point-size="10" color="#3730A3">every 3 minutes</font>>,
           shape=box3d, fillcolor="#EEF2FF", color="#4F46E5"];
  fetchc  [label=<<b>Collect every comment</b><br/><font point-size="10" color="#6B7280">reviews + inline</font>>,
           fillcolor="#F9FAFB", color="#9CA3AF"];
  ci      [class="pulse", label=<<b>Checks green?</b>>, shape=diamond, fillcolor="#FEF9C3", color="#EAB308", penwidth=1.8];
  decide  [class="pulse", label=<<b>Approved?</b>>, shape=diamond, fillcolor="#FEF9C3", color="#EAB308", penwidth=1.8];
  fix     [class="pulse", label=<<b>Handle the feedback</b><br/><font point-size="10" color="#991B1B">fix it or answer it</font>>,
           fillcolor="#FEE2E2", color="#EF4444"];
  commit  [label=<<b>Commit</b><br/><font point-size="10" color="#991B1B">only the files you touched</font>>,
           fillcolor="#FEE2E2", color="#EF4444"];
  push    [label=<<b>Push</b><br/><font point-size="10" color="#991B1B">never force</font>>,
           fillcolor="#FEE2E2", color="#EF4444"];
  label_  [label=<<b>Label it right</b><br/><font point-size="10" color="#6B7280">pr-labeler</font>>,
           fillcolor="#F3F4F6", color="#9CA3AF"];

  merge   [class="pulse", label=<<b>Merge safely</b><br/><font point-size="10" color="#047857">verified, never forced</font>>,
           shape=box3d, fillcolor="#ECFDF5", color="#10B981"];
  cleanup [class="pulse", label=<<b>Clean up</b><br/><font point-size="10" color="#047857">worktree + branch</font>>,
           fillcolor="#ECFDF5", color="#10B981"];
  done    [class="pulse", label=<<b>Done</b><br/><font point-size="10" color="#065F46">issue linked + merged</font>>,
           shape=octagon, fillcolor="#D1FAE5", color="#10B981", fontcolor="#065F46", penwidth=2];

  // ---------------- edges ----------------
  main -> sync -> plan -> fanout;
  fanout -> issue [style=dashed, color="#EAB308"];
  issue -> fanout [style=dashed, color="#EAB308", constraint=false, label=" resume "];

  fanout -> a_wt [label=" task A "];
  fanout -> b_wt [label=" task B "];
  fanout -> c_wt [label=" task C "];

  a_pr -> monitor;
  b_pr -> monitor;
  c_pr -> monitor;
  a_pr -> label_ [style=dashed, color="#9CA3AF"];
  label_ -> monitor [style=dashed, color="#9CA3AF"];

  monitor -> fetchc -> decide;
  monitor -> ci;
  ci -> fix [label=" failing ", color="#DC2626", fontcolor="#DC2626"];
  decide -> fix [label=" changes requested ", color="#DC2626", fontcolor="#DC2626"];
  fix -> commit -> push;
  push -> monitor [label=" re-review ", style=dashed, color="#EF4444", fontcolor="#DC2626"];

  decide -> merge [label=" approved "];
  merge -> cleanup -> done;
  done -> main [label=" next task ", style=dashed, color="#10B981", fontcolor="#047857",
               constraint=false];

  // ---------------- ranks ----------------
  { rank=same; main; }
  { rank=same; sync; }
  { rank=same; plan; }
  { rank=same; fanout; issue; }
  { rank=same; monitor; }
  { rank=same; fetchc; ci; }
  { rank=same; decide; }
  { rank=same; merge; fix; }
  { rank=same; cleanup; commit; }
  { rank=same; done; push; }
  { rank=same; label_; }
}
